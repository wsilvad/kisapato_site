NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000

# PostgreSQL hospedado na Discloud (painel da Discloud > seu banco > credenciais)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# API rodando na sua máquina: use o host e a porta do túnel TCP da Discloud (normalmente localhost).
# API rodando na própria Discloud: use o host interno informado no painel.
# Se a Discloud exigir SSL, acrescente ?sslmode=require ao final da URL.
# Caracteres especiais na senha (@ : / #) precisam ser codificados (ex.: @ vira %40).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# Opcional: conexão usada só pelo CLI do Prisma (migrate, studio, seed).
# Se ficar comentada, o CLI usa a DATABASE_URL.
# DIRECT_URL=""
