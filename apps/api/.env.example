NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000

# Supabase > Project Settings > Database > Connection string
# Runtime da API: pooler em modo transaction (porta 6543)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres"

# Migrations do Prisma: conexão direta (porta 5432) ou session pooler
DIRECT_URL="postgresql://postgres:<SENHA>@db.<PROJECT_REF>.supabase.co:5432/postgres"
