NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000

# PostgreSQL hospedado na Discloud (painel da Discloud > seu banco > credenciais)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# API rodando na sua máquina: use o host e a porta do túnel TCP da Discloud (normalmente localhost).
# API rodando na própria Discloud: use o host interno informado no painel.
# Se a Discloud exigir SSL, acrescente ?sslmode=require ao final da URL.
# Caracteres especiais na senha (@ : / #) precisam ser codificados (ex.: @ vira %40).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# Opcional: conexão usada só pelo CLI do Prisma (migrate, studio, seed).
# Se ficar comentada, o CLI usa a DATABASE_URL.
# DIRECT_URL=""

# Segredo do JWT (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=""
JWT_EXPIRES_IN=7d

# Pasta das fotos de produtos enviadas pelo painel admin (servidas em /uploads)
UPLOAD_DIR=uploads
# Fila de fotos (opcional): quantas processam juntas e quantos MB podem esperar na memória
# UPLOAD_CONCURRENCY=1
# UPLOAD_QUEUE_MB=300

# Chave que cifra o segredo da verificação em duas etapas no banco (32 bytes em base64).
# Gere com: openssl rand -base64 32   Guarde só nas variáveis do servidor.
# Em desenvolvimento, se ficar vazia, deriva do JWT_SECRET. Em produção, sem ela o 2FA fica indisponível.
DATA_ENCRYPTION_KEY=""

# Quantos proxies confiáveis ficam na frente da API (limitador de tentativas). Na Discloud: 1 (padrão em produção).
# TRUST_PROXY=1

# E-mail (cadastro e recuperar senha). Escolha UM jeito; sem nenhum, em produção o cadastro fica indisponível
# e em desenvolvimento o código sai no log da API.
#
# 1) Gmail (mais simples). Exige a verificação em duas etapas na conta Google e uma SENHA DE APP:
#    Conta Google > Segurança > Senhas de app. Cole a senha com ou sem os espaços. O remetente será a própria conta.
#    Recomendado: um Gmail só da loja, não o pessoal. Testar: npm run mail:test -w @ki-sapato/api -- seu@email.com
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""
#
# 2) Outro provedor (Brevo, Amazon SES, Resend…): URL SMTP, ex.: smtps://usuario:senha@smtp.exemplo.com:465
#    (caracteres especiais no usuário e na senha precisam ser codificados, ex.: @ vira %40). Tem prioridade sobre o Gmail.
# SMTP_URL=""
#
# Remetente exibido. Com o Gmail, use o próprio endereço (o Gmail ignora outro).
# MAIL_FROM="Ki Sapato <nao-responda@seudominio.com.br>"

# SMS (cadastro, confirmar telefone e recuperar senha). O CADASTRO EXIGE e-mail E SMS: sem eles, em produção, ninguém consegue se cadastrar.
# SMS_DRIVER=twilio envia de verdade (precisa das 3 variáveis abaixo, do painel da Twilio).
# SMS_DRIVER=console só funciona fora de produção e imprime o código no log da API.
# SMS_DRIVER=twilio
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""   # número de origem em formato +E.164 ou o SID de um Messaging Service (MG...)

# Confirmação do telefone por SMS no cadastro: auto (padrão), required ou off.
# auto = liga sozinha quando houver provedor de SMS configurado (acima); sem provedor, o cadastro pede só o código do e-mail.
# required = sempre exige (sem SMS o cadastro fica indisponível). off = nunca exige. O telefone é obrigatório nos três casos.
# PHONE_VERIFICATION=auto

# Gateway que tokeniza cartões (ex.: mercadopago). Sem ele, salvar cartão fica indisponível.
# CARD_PROVIDER=""


# ERP (Macle ControleWS, só leitura): o botão "Atualizar do ERP" em Produtos e o script erp:import usam este endereço.
# ERP_URL=http://<host>:<porta>/ControleWS/ControleWS
# Medição do site (docs/analytics). Só grava depois de aplicar as migrations 20261021000000 e 20261021010000.
# ANALYTICS_ENABLED=true            # false desliga a gravação de eventos e a manutenção diária
# ANALYTICS_IDENTIFY=false          # true liga o visitante ao cliente logado (decisão de privacidade; ver docs/analytics/privacy.md)
# ANALYTICS_RETENTION_MONTHS=13     # meses de eventos brutos
# METRICS_API_KEY=""                # chave da API de métricas (24+ caracteres, aleatória); sem ela a API de métricas fica desligada
# METRICS_DATABASE_URL=""           # conexão do usuário somente leitura bi_reader (ver docs/analytics/OPERATIONS.md)

# Admin criado pelo seed (npm run db:seed); a senha fica só no seu .env
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
