generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductBadge {
  LANCAMENTO
  PROMOCAO
  DESTAQUE
}

enum StockMovementType {
  SALE
  CANCELLATION
  ADJUSTMENT
}

/// Como as numerações do produto são lidas: números (34, 35…) ou grade de confecção (P, M, G…).
enum SizeScheme {
  NUMERACAO
  CONFECCAO
}

/// Faixa etária do produto.
enum AgeGroup {
  ADULTO
  INFANTIL
}

/// Gênero do produto; unissex aparece tanto em feminino quanto em masculino.
enum Gender {
  FEMININO
  MASCULINO
  UNISSEX
}

enum OrderStatus {
  PENDING
  PAID
  PICKING
  SHIPPED
  DELIVERED
  CANCELED
}

/// Perfil do usuário (cliente ou administrador).
model Profile {
  id                        String             @id @default(uuid()) @db.Uuid
  email                     String             @unique
  passwordHash              String
  /// Nome completo.
  name                      String?
  phone                     String?
  /// CPF só com dígitos (nota fiscal). Único: uma conta por CPF.
  cpf                       String?            @unique
  /// Telefone confirmado por código. Só ele serve para recuperar a senha por SMS; único para o SMS achar uma conta só.
  verifiedPhone             String?            @unique
  /// E-mail confirmado por código (contas criadas antes da confirmação obrigatória ficam sem data).
  emailVerifiedAt           DateTime?
  /// Cadastro novo que ainda não confirmou e-mail e telefone: não entra, não reserva e-mail/CPF e pode ser substituído.
  pendingVerification       Boolean            @default(false)
  role                      Role               @default(CUSTOMER)
  /// Áreas do painel que este usuário pode usar (só vale para ADMIN). "*" = acesso total; vazio = acesso ao painel desativado.
  adminPermissions          String[]           @default([])
  /// Sobe a cada troca de senha ou de 2FA e derruba as sessões abertas (o token guarda a versão).
  tokenVersion              Int                @default(0)
  passwordChangedAt         DateTime?
  twoFactorEnabled          Boolean            @default(false)
  /// Segredo TOTP cifrado (AES-256-GCM). Nunca sai da API; fica oculto das consultas por padrão.
  twoFactorSecret           String?
  /// O cliente já viu e dispensou a oferta de ativar a verificação em duas etapas.
  twoFactorOfferDismissedAt DateTime?
  orders                    Order[]
  addresses                 Address[]
  cards                     SavedCard[]
  codes                     VerificationCode[]
  recoveryCodes             RecoveryCode[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@map("profiles")
}

/// Endereço de entrega do cliente. Um só é o padrão (`isDefault`) e vem preenchido nas compras.
model Address {
  id         String   @id @default(uuid())
  profileId  String   @db.Uuid
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Apelido ("Casa", "Trabalho").
  label      String?
  recipient  String
  /// CEP só com dígitos.
  zip        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileId])
  @@map("addresses")
}

/// Cartão salvo: só o que o gateway de pagamento devolve (token, bandeira, 4 últimos dígitos e validade).
/// O número completo e o CVV nunca passam por aqui nem são gravados.
model SavedCard {
  id         String   @id @default(uuid())
  profileId  String   @db.Uuid
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Gateway que emitiu o token (ex.: "mercadopago").
  provider   String
  /// Token do cartão no gateway.
  token      String
  brand      String
  last4      String
  expMonth   Int
  expYear    Int
  holderName String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([provider, token])
  @@index([profileId])
  @@map("saved_cards")
}

enum CodeChannel {
  EMAIL
  SMS
}

enum CodePurpose {
  PASSWORD_RESET
  PHONE_VERIFY
  EMAIL_VERIFY
}

/// Código de uso único enviado por e-mail ou SMS (recuperar senha, confirmar telefone). Só o hash é guardado.
model VerificationCode {
  id          String      @id @default(uuid())
  profileId   String      @db.Uuid
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  channel     CodeChannel
  purpose     CodePurpose
  /// E-mail ou telefone para onde o código foi enviado.
  destination String
  codeHash    String
  expiresAt   DateTime
  attempts    Int         @default(0)
  consumedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([profileId, purpose])
  @@map("verification_codes")
}

/// Códigos de emergência da verificação em duas etapas (uso único). Só o hash é guardado.
model RecoveryCode {
  id        String    @id @default(uuid())
  profileId String    @db.Uuid
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId])
  @@map("recovery_codes")
}

/// Classe de produto: o nível acima da categoria (ex.: Calçados, Acessórios).
model ProductClass {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  sortOrder  Int        @default(0)
  /// Inativa: some da loja junto com as categorias e produtos dela.
  active     Boolean    @default(true)
  categories Category[]

  @@map("product_classes")
}

/// Marca do produto (ex.: Ki Sapato, Vizzano). Cadastro próprio, reutilizado por vários produtos.
model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  /// Inativa: seus produtos somem da loja.
  active    Boolean   @default(true)
  /// Código da marca no ERP (codMarca); liga a marca do site à do ERP na importação.
  erpCode   String?   @unique
  products  Product[]

  @@map("brands")
}

/// Atalho de público (ex.: Feminino, Masculino, Infantil, Menina): um cartão da home que leva aos produtos
/// de uma faixa etária e/ou gênero. Vazio em `ageGroup`/`gender` significa "todos".
model Audience {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  /// Foto do cartão "Compre por público" na home; sem foto, o público não aparece lá.
  imageUrl  String?
  sortOrder Int       @default(0)
  ageGroup  AgeGroup?
  gender    Gender?
  /// Legado: vínculo antigo produto↔público, trocado por `Product.ageGroup`/`gender`. Sai depois do deploy.
  products  Product[]

  @@map("audiences")
}

model Category {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  classId      String?
  productClass ProductClass? @relation(fields: [classId], references: [id])
  /// Foto do cartão "Compre por categoria" na home.
  imageUrl     String?
  sortOrder    Int           @default(0)
  showOnHome   Boolean       @default(false)
  /// Inativa: some da loja junto com os produtos dela.
  active       Boolean       @default(true)
  products     Product[]

  @@index([classId])
  @@map("categories")
}

model Product {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  description      String?
  careInstructions String?
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id])
  reference        String?
  price            Decimal          @db.Decimal(10, 2)
  compareAtPrice   Decimal?         @db.Decimal(10, 2)
  /// Custo de compra; base para margem e lucro nos indicadores.
  costPrice        Decimal?         @db.Decimal(10, 2)
  badge            ProductBadge?
  /// URLs das fotos; a primeira é a principal.
  images           String[]
  active           Boolean          @default(true)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  ageGroup         AgeGroup         @default(ADULTO)
  gender           Gender           @default(UNISSEX)
  /// Legado (ver `Audience.products`); a loja usa `ageGroup` e `gender`.
  audiences        Audience[]
  variants         ProductVariant[]
  /// Fotos de cada cor (até 4); a ordem das cores define a primeira, que abre a página do produto.
  colors           ProductColor[]
  sizeScheme       SizeScheme       @default(NUMERACAO)
  /// Produto vindo do ERP: referência do fornecedor (`refFornecedor`) e código da marca; juntos são a chave do pai.
  erpRef           String?
  erpBrandCode     String?
  /// Nome como vem do ERP (descrição sem a cor, com a referência). Só o ERP muda; `name` é o nome exibido no site.
  erpName          String?
  erpSyncedAt      DateTime?
  /// Pendência da última atualização com o ERP (aviso no topo de Produtos), se houver.
  erpIssue         ErpIssue?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([erpBrandCode, erpRef])
  @@index([categoryId])
  @@index([brandId])
  @@index([ageGroup, gender])
  @@map("products")
}

/// Cor de um produto (o "filho" do produto pai) com as fotos dela. As numerações dessa cor são as `ProductVariant`
/// com o mesmo nome em `color`. Sem fotos aqui, a cor usa as fotos gerais do produto (`Product.images`).
model ProductColor {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  /// Posição da cor no produto: a de menor número é a primeira.
  position    Int      @default(0)
  /// URLs das fotos da cor (no máximo 4); a primeira é a principal.
  images      String[]
  /// Desabilitada: o ERP deixou de marcar este item para o site. Some da loja e não pode ser comprada (a atualização com o ERP liga e desliga).
  active      Boolean  @default(true)
  /// O ERP marca este item para o site? Cor do ERP sem a marca não pode ser habilitada no painel; com a marca, o painel pode desabilitar só no site (a atualização respeita).
  erpFlagged  Boolean  @default(true)
  /// Item do ERP que origina esta cor ("empresa.item", ex.: 1.2578) e o custo dele.
  erpItemCode String?  @unique
  costPrice   Decimal? @db.Decimal(10, 2)
  /// Preço desta cor (e o "de" riscado). Vazio = vale o preço do produto, que é o menor entre as cores.
  price          Decimal? @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, name])
  @@map("product_colors")
}

/// Combinação de numeração + cor, com estoque próprio.
model ProductVariant {
  id          String          @id @default(uuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String          @unique
  size        Int
  color       String
  stock       Int             @default(0)
  /// Código do tamanho no ERP (codTamanho) e EAN, quando vierem de lá.
  erpSizeCode String?
  /// Rótulo da grade de confecção ("P", "M", "G", "Único"…); vazio = mostra o número de `size`.
  sizeLabel   String?
  ean         String?
  orderItems  OrderItem[]
  movements   StockMovement[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model Order {
  id              String       @id @default(uuid())
  profileId       String       @db.Uuid
  profile         Profile      @relation(fields: [profileId], references: [id])
  status          OrderStatus  @default(PENDING)
  total           Decimal      @db.Decimal(10, 2)
  shippingAddress Json
  /// Transportadora, código e link de rastreio (preenchidos ao enviar).
  carrier         String?
  trackingCode    String?
  trackingUrl     String?
  /// Observação interna da equipe (o cliente nunca vê).
  internalNote    String?
  items           OrderItem[]
  events          OrderEvent[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([profileId])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
  /// Custo do produto no momento da venda (para o lucro não mudar se o custo for reajustado).
  unitCost  Decimal?       @db.Decimal(10, 2)
  /// Conferido na separação do estoque.
  picked    Boolean        @default(false)

  @@index([orderId])
  @@map("order_items")
}

/// Banners da home (hero).
model Campaign {
  id              String    @id @default(uuid())
  eyebrow         String?
  title           String
  body            String?
  buttonLabel     String?
  buttonUrl       String?
  desktopImageUrl String?
  mobileImageUrl  String?
  /// Enquadramento da foto (ponto de foco em % e zoom) para computador e celular, definido no editor do admin.
  desktopFocusX   Float     @default(50)
  desktopFocusY   Float     @default(50)
  desktopZoom     Float     @default(1)
  mobileFocusX    Float     @default(50)
  mobileFocusY    Float     @default(50)
  mobileZoom      Float     @default(1)
  startsAt        DateTime?
  endsAt          DateTime?
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("campaigns")
}

/// Cartão vertical em movimento (GIF ou foto) na home, no estilo "stories"; leva a um produto ou link.
model Story {
  id        String   @id @default(uuid())
  /// Legenda curta sobre a imagem (opcional).
  title     String?
  /// GIF animado (convertido em WebP animado pelo envio) ou foto.
  mediaUrl  String
  /// Para onde o cartão leva (ex.: /produtos/bota-couro-trail); vazio = não é clicável.
  linkUrl   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stories")
}

/// Vitrines da home: seleção automática de produtos por selo.
model Showcase {
  id            String       @id @default(uuid())
  title         String
  selectionRule ProductBadge @default(DESTAQUE)
  itemLimit     Int          @default(4)
  sortOrder     Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("showcases")
}

/// Conteúdo editável do site (avisos do topo, menu, faixa promocional, benefícios, rodapé).
/// Uma linha por chave; o valor é validado em modules/settings.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// Histórico de entradas e saídas de estoque de cada variação.
model StockMovement {
  id        String            @id @default(uuid())
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      StockMovementType
  /// Variação do estoque: negativa = saída, positiva = entrada.
  quantity  Int
  /// Estoque da variação depois deste movimento.
  balance   Int
  note      String?
  orderId   String?
  createdAt DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

/// Histórico de situações do pedido (quando mudou e para quê).
model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Pendência da atualização com o ERP: produto que não pôde ser importado (ou foi importado com ressalvas) e o motivo.
/// A chave é a do pai (marca + referência); some sozinha quando a atualização seguinte não encontra mais o problema.
model ErpIssue {
  id        String   @id @default(uuid())
  brandCode String
  ref       String
  brandName String
  /// Motivos, um por linha.
  reason    String
  /// Produto do site, quando a pendência é de um produto já importado.
  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandCode, ref])
  @@map("erp_issues")
}
