generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductBadge {
  LANCAMENTO
  PROMOCAO
  DESTAQUE
}

enum StockMovementType {
  SALE
  CANCELLATION
  ADJUSTMENT
}

/// Faixa etária do produto.
enum AgeGroup {
  ADULTO
  INFANTIL
}

/// Gênero do produto; unissex aparece tanto em feminino quanto em masculino.
enum Gender {
  FEMININO
  MASCULINO
  UNISSEX
}

enum OrderStatus {
  PENDING
  PAID
  PICKING
  SHIPPED
  DELIVERED
  CANCELED
}

/// Perfil do usuário (cliente ou administrador).
model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  role         Role     @default(CUSTOMER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

/// Classe de produto: o nível acima da categoria (ex.: Calçados, Acessórios).
model ProductClass {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  sortOrder  Int        @default(0)
  /// Inativa: some da loja junto com as categorias e produtos dela.
  active     Boolean    @default(true)
  categories Category[]

  @@map("product_classes")
}

/// Marca do produto (ex.: Ki Sapato, Vizzano). Cadastro próprio, reutilizado por vários produtos.
model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  /// Inativa: seus produtos somem da loja.
  active    Boolean   @default(true)
  products  Product[]

  @@map("brands")
}

/// Atalho de público (ex.: Feminino, Masculino, Infantil, Menina): um cartão da home que leva aos produtos
/// de uma faixa etária e/ou gênero. Vazio em `ageGroup`/`gender` significa "todos".
model Audience {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  /// Foto do cartão "Compre por público" na home; sem foto, o público não aparece lá.
  imageUrl  String?
  sortOrder Int       @default(0)
  ageGroup  AgeGroup?
  gender    Gender?
  /// Legado: vínculo antigo produto↔público, trocado por `Product.ageGroup`/`gender`. Sai depois do deploy.
  products  Product[]

  @@map("audiences")
}

model Category {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  classId      String?
  productClass ProductClass? @relation(fields: [classId], references: [id])
  /// Foto do cartão "Compre por categoria" na home.
  imageUrl     String?
  sortOrder    Int           @default(0)
  showOnHome   Boolean       @default(false)
  /// Inativa: some da loja junto com os produtos dela.
  active       Boolean       @default(true)
  products     Product[]

  @@index([classId])
  @@map("categories")
}

model Product {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  description      String?
  careInstructions String?
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id])
  reference        String?
  price            Decimal          @db.Decimal(10, 2)
  compareAtPrice   Decimal?         @db.Decimal(10, 2)
  /// Custo de compra; base para margem e lucro nos indicadores.
  costPrice        Decimal?         @db.Decimal(10, 2)
  badge            ProductBadge?
  /// URLs das fotos; a primeira é a principal.
  images           String[]
  active           Boolean          @default(true)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  ageGroup         AgeGroup         @default(ADULTO)
  gender           Gender           @default(UNISSEX)
  /// Legado (ver `Audience.products`); a loja usa `ageGroup` e `gender`.
  audiences        Audience[]
  variants         ProductVariant[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([ageGroup, gender])
  @@map("products")
}

/// Combinação de numeração + cor, com estoque próprio.
model ProductVariant {
  id         String          @id @default(uuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String          @unique
  size       Int
  color      String
  stock      Int             @default(0)
  orderItems OrderItem[]
  movements  StockMovement[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model Order {
  id              String       @id @default(uuid())
  profileId       String       @db.Uuid
  profile         Profile      @relation(fields: [profileId], references: [id])
  status          OrderStatus  @default(PENDING)
  total           Decimal      @db.Decimal(10, 2)
  shippingAddress Json
  /// Transportadora, código e link de rastreio (preenchidos ao enviar).
  carrier         String?
  trackingCode    String?
  trackingUrl     String?
  /// Observação interna da equipe (o cliente nunca vê).
  internalNote    String?
  items           OrderItem[]
  events          OrderEvent[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([profileId])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
  /// Custo do produto no momento da venda (para o lucro não mudar se o custo for reajustado).
  unitCost  Decimal?       @db.Decimal(10, 2)
  /// Conferido na separação do estoque.
  picked    Boolean        @default(false)

  @@index([orderId])
  @@map("order_items")
}

/// Banners da home (hero).
model Campaign {
  id              String    @id @default(uuid())
  eyebrow         String?
  title           String
  body            String?
  buttonLabel     String?
  buttonUrl       String?
  desktopImageUrl String?
  mobileImageUrl  String?
  /// Enquadramento da foto (ponto de foco em % e zoom) para computador e celular, definido no editor do admin.
  desktopFocusX   Float     @default(50)
  desktopFocusY   Float     @default(50)
  desktopZoom     Float     @default(1)
  mobileFocusX    Float     @default(50)
  mobileFocusY    Float     @default(50)
  mobileZoom      Float     @default(1)
  startsAt        DateTime?
  endsAt          DateTime?
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("campaigns")
}

/// Vitrines da home: seleção automática de produtos por selo.
model Showcase {
  id            String       @id @default(uuid())
  title         String
  selectionRule ProductBadge @default(DESTAQUE)
  itemLimit     Int          @default(4)
  sortOrder     Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("showcases")
}

/// Conteúdo editável do site (avisos do topo, menu, faixa promocional, benefícios, rodapé).
/// Uma linha por chave; o valor é validado em modules/settings.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// Histórico de entradas e saídas de estoque de cada variação.
model StockMovement {
  id        String            @id @default(uuid())
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      StockMovementType
  /// Variação do estoque: negativa = saída, positiva = entrada.
  quantity  Int
  /// Estoque da variação depois deste movimento.
  balance   Int
  note      String?
  orderId   String?
  createdAt DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

/// Histórico de situações do pedido (quando mudou e para quê).
model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}
